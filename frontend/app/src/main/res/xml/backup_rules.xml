<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        The Room database contains a refreshable API cache and must not be
        restored over a newly installed application.
    -->
    <exclude domain="database" path="." />

    <!-- DataStore contains Firebase tokens and onboarding state. -->
    <exclude domain="file" path="datastore" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
